{
  "name": "panda-animation",
  "version": "0.1.1",
  "description": "animation preset for pandacss",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "main": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "clean-package": {
    "replace": {
      "exports": {
        ".": {
          "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
          },
          "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
          }
        }
      }
    }
  },
  "scripts": {
    "release": "pnpm build && pnpm publish --no-git-checks",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "check-type": "tsgo --noEmit",
    "lint": "eslint --max-warnings 0 --fix",
    "build": "tsdown"
  },
  "devDependencies": {
    "clean-package": "^2.2.0",
    "tsdown": "^0.21.3",
    "@jongh/tsconfig": "workspace:*",
    "@jongh/eslint": "workspace:*",
    "@pandacss/dev": "catalog:"
  }
}
