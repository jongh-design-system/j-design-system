{
  "name": "@jongh/ui",
  "version": "2.20260905.2",
  "private": false,
  "description": "Headless UI components for React",
  "type": "module",
  "scripts": {
    "codegen": "panda codegen",
    "generate:icons": "node scripts/generate-icons.mjs && prettier --write src/icon/generated",
    "lint": "eslint --max-warnings 0 --no-warn-ignored --fix",
    "prepare": "pnpm codegen && pnpm generate:icons",
    "prepack": "pnpm build",
    "test": "pnpm codegen && vitest run --project=storybook",
    "test-storybook": "pnpm codegen && vitest run --project=storybook",
    "storybook": "pnpm codegen && storybook dev -p 6006",
    "build": "pnpm codegen && panda cssgen --splitting && vite build --config vite.lib.config.ts",
    "build:storybook": "pnpm codegen && storybook build",
    "check-type": "pnpm codegen && tsgo --noEmit"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./theme/blue.css": "./dist/blue.css",
    "./theme/purple.css": "./dist/purple.css"
  },
  "dependencies": {
    "radix-ui": "^1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.1.1",
    "@jongh/eslint": "workspace:*",
    "@jongh/tsconfig": "workspace:*",
    "@microsoft/api-extractor": "7.59.0",
    "@pandacss/dev": "catalog:",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "catalog:",
    "axe-playwright": "^2.0.1",
    "chromatic": "^11.5.4",
    "eslint-plugin-storybook": "10.5.10",
    "motion": "^13.1.0",
    "playwright": "catalog:",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.56.3",
    "storybook": "10.5.10",
    "vite": "8.2.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "5.0.3",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongh-design-system/jds.git",
    "directory": "packages/ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
