{
  "name": "@jongh/ui",
  "version": "1.6.5",
  "description": "Headless UI components for React",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "codegen": "panda codegen",
    "lint": "eslint --max-warnings 0 --no-warn-ignored --fix",
    "test": "pnpm run codegen && vitest run",
    "test:packed-output:prepare": "node ./scripts/test-packed-output.mjs",
    "test:packed-output": "pnpm run codegen && pnpm run test:packed-output:prepare && PACKED_NEW_SYSTEM_OUTPUT_DIR=./.tmp/packed-output/package pnpm exec vitest run --config vitest.packed.config.mjs",
    "test-storybook": "pnpm run codegen && vitest --project=storybook",
    "storybook": "pnpm run codegen && storybook dev -p 6006",
    "build": "pnpm exec tsdown --config tsdown.config.ts",
    "build:storybook": "pnpm run codegen && storybook build",
    "check-type": "pnpm run codegen && tsgo --noEmit"
  },
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@jongh/new-system-output": "workspace:*",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.475.0",
    "radix-ui": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "@vitejs/plugin-react": "catalog:",
    "@chromatic-com/storybook": "^4.0.0",
    "@jongh/eslint": "workspace:*",
    "@jongh/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^9.1.5",
    "@storybook/addon-docs": "^9.1.5",
    "@storybook/addon-links": "^9.1.5",
    "@storybook/addon-onboarding": "^9.1.5",
    "@storybook/addon-themes": "^9.1.5",
    "@storybook/addon-vitest": "9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@vitest/browser": "3.0.5",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "axe-playwright": "^2.0.1",
    "chromatic": "^11.5.4",
    "panda-animation": "workspace:*",
    "playwright": "catalog:",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "storybook": "^9.1.5",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "3.0.5",
    "@pandacss/studio": "^0.46.1",
    "react-hook-form": "^7.56.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
