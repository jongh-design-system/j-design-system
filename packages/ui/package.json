{
  "name": "@jongh/ui",
  "version": "1.6.5",
  "private": true,
  "description": "Headless UI components for React",
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings 0 --no-warn-ignored --fix",
    "prepare": "panda codegen",
    "test": "panda codegen && JDS_STYLE=panda vitest run --project=storybook && JDS_STYLE=tailwind vitest run --project=storybook",
    "test-storybook": "panda codegen && vitest run --project=storybook",
    "test-storybook:panda": "panda codegen && JDS_STYLE=panda vitest run --project=storybook",
    "test-storybook:tailwind": "JDS_STYLE=tailwind vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:panda": "JDS_STYLE=panda storybook dev -p 6006",
    "storybook:tailwind": "JDS_STYLE=tailwind storybook dev -p 6007",
    "build": "storybook build",
    "check-type": "tsgo --noEmit"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.475.0",
    "radix-ui": "^1.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.56.3",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.1.1",
    "@jongh/eslint": "workspace:*",
    "@jongh/tsconfig": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "catalog:",
    "axe-playwright": "^2.0.1",
    "chromatic": "^11.5.4",
    "eslint-plugin-storybook": "10.5.10",
    "playwright": "catalog:",
    "storybook": "10.5.10",
    "tailwindcss": "^4.2.4",
    "vite": "8.2.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "catalog:"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
