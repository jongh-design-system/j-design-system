{
  "extends": "@jongh/tsconfig/react.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@styled-system/*": ["./styled-system/*"],
      "@utils/*": ["./src/utils/*"],
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["src", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
