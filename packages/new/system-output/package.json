{
  "name": "@jongh/new-system-output",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.ts && pnpm exec tsdown --config tsdown.config.ts",
    "lint": "eslint --max-warnings 0 --no-warn-ignored .",
    "check-type": "tsgo --noEmit",
    "test": "pnpm exec vitest run"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./tokens": {
      "types": "./dist/generated/tokens/index.d.ts",
      "import": "./dist/generated/tokens/index.js"
    },
    "./recipes/*": {
      "types": "./dist/generated/recipes/*.d.ts",
      "import": "./dist/generated/recipes/*.js"
    },
    "./styles/reset.css": "./dist/generated/styles/reset.css",
    "./styles/base.css": "./dist/generated/styles/base.css",
    "./styles/all.css": "./dist/generated/styles/all.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/react": "^19.0.8",
    "@jongh/eslint": "workspace:*",
    "@jongh/new-system-core": "workspace:*",
    "@jongh/new-system-spec": "workspace:*",
    "@jongh/tsconfig": "workspace:*",
    "react": "^19.0.0",
    "tsdown": "catalog:"
  }
}
