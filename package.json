{
  "name": "jh-design",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ignore-pattern 'styled-system/'",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commit": "git-cz",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish",
    "ci": "turbo run lint check-type test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/cz-commitlint": "^19.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260326.1",
    "@vitest/coverage-v8": "catalog:",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.20.1",
    "husky": "^9.1.4",
    "inquirer": "9",
    "lint-staged": "^15.2.7",
    "playwright": "catalog:",
    "prettier": "^3.5.2",
    "turbo": "^2.0.9",
    "typescript": "^6",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "workspaces": [
    "packages/*",
    "app/*",
    "configs/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongh-design-system/jds.git"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "pnpm": {
    "overrides": {
      "@storybook/addon-docs>react": "18.3.1",
      "@storybook/addon-docs>react-dom": "18.3.1"
    },
    "packageExtensions": {
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "*"
        }
      }
    }
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1"
  }
}
