{
  "name": "jh-design",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "test": "turbo run test",
    "lint": "eslint . --ignore-pattern 'styled-system/'",
    "ci:version": "node scripts/release/version-packages.js",
    "ci:publish": "changeset publish",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "ci": "turbo run lint check-type test"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "^7.1.1",
    "@changesets/assemble-release-plan": "^6.0.10",
    "@changesets/cli": "^2.27.10",
    "@changesets/config": "^3.1.4",
    "@changesets/read": "^0.6.7",
    "@manypkg/get-packages": "^1.1.3",
    "@typescript/native-preview": "^7.0.0-dev.20260326.1",
    "eslint": "^9.20.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.7",
    "prettier": "^3.5.2",
    "turbo": "^2.0.9",
    "typescript": "^6"
  },
  "workspaces": [
    "packages/*",
    "app/*",
    "configs/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongh-design-system/jds.git"
  },
  "pnpm": {
    "overrides": {
      "@storybook/addon-docs>react": "18.3.1",
      "@storybook/addon-docs>react-dom": "18.3.1"
    },
    "packageExtensions": {
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "*"
        }
      }
    }
  }
}
