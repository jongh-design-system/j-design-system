{
  "name": "cursor-figma-mcp-jh",
  "description": "my figma mcp server using cursor-talk-to-figma-mcp",
  "version": "0.0.1",
  "module": "dist/server.js",
  "main": "dist/server.js",
  "bin": {
    "cursor-talk-to-figma-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "socket": "npx tsx src/socket.ts",
    "setup": "./scripts/setup.sh",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "pnpm run build:watch",
    "pub:release": "pnpm run build && pnpm publish",
    "clean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.110.0",
    "@figma/rest-api-spec": "^0.29.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "@typescript/native-preview": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "@types/react": "^18.2.55",
    "@types/styled-components": "^5.1.34",
    "@types/ws": "^8.5.10",
    "figma-api": "2.0.2-beta",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.8",
    "uuid": "latest",
    "ws": "latest",
    "zod": "latest"
  },
  "engines": {
    "node": ">=18"
  }
}
