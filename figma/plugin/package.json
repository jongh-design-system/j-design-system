{
  "name": "@jongh/figma-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plugma dev",
    "build": "plugma build",
    "preview": "plugma preview",
    "release": "plugma release",
    "socket": "npx tsx src/socket.ts",
    "start": "concurrently \"npm run socket\" \"npm run dev\" --names \"SOCKET,MCP\" --prefix-colors \"blue,green\"",
    "lint": "eslint --fix",
    "format": "prettier --write"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "zod": "latest",
    "uuid": "latest"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vite": "^5.4.10",
    "@figma/plugin-typings": "^1.100.2",
    "plugma": "^1.2.9",
    "@jongh/eslint": "workspace:*",
    "concurrently": "^8"
  },
  "plugma": {
    "manifest": {
      "id": "test-replace",
      "name": "test",
      "main": "src/main.ts",
      "ui": "src/ui.tsx",
      "editorType": [
        "figma",
        "figjam"
      ],
      "documentAccess": "dynamic-page",
      "networkAccess": {
        "allowedDomains": [
          "none"
        ],
        "devAllowedDomains": [
          "http://localhost:*",
          "ws://localhost:9001"
        ]
      }
    }
  }
}
